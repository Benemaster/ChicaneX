<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_bottom"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Navigate Button -->
    <LinearLayout
        android:id="@+id/btnNavigate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/navigate"
            android:src="@drawable/ic_navigate"
            android:tint="@color/rally_red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/orbitron_regular"
            android:letterSpacing="0.1"
            android:text="@string/navigate"
            android:textColor="@color/rally_red"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Map Mode Button -->
    <LinearLayout
        android:id="@+id/btnMapMode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/map_mode"
            android:src="@drawable/ic_map"
            android:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/orbitron_regular"
            android:letterSpacing="0.1"
            android:text="@string/map_mode"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

    </LinearLayout>

    <!-- Settings Button -->
    <LinearLayout
        android:id="@+id/btnSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/orbitron_regular"
            android:letterSpacing="0.1"
            android:text="@string/settings"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />

    </LinearLayout>

</LinearLayout>
